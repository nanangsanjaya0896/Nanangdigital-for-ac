# ============================================================================
# Konfigurasi Tracking, Google Search Console, & Meta CAPI LP NanangDigital
# Isi variabel ini di menu Settings > Environment Variables pada dashboard Vercel
# ============================================================================

# 1. Google Analytics 4 Measurement ID (contoh: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# 2. Google Search Console HTML Tag Verification
# Bisa diisi kode langsung (contoh: abc123xyz) ATAU tag <meta ...> utuh dari Google Search Console
VITE_GSC_VERIFICATION=

# 3. Dataset / Pixel ID 15-16 digit dari Meta Events Manager (dipakai Browser & Server)
VITE_META_PIXEL_ID=
META_PIXEL_ID=

# 4. Access Token Rahasia Conversions API dari Meta Events Manager > Settings
# PENTING: JANGAN beri awalan VITE_ agar token tetap rahasia hanya di server Vercel!
META_CAPI_ACCESS_TOKEN=

# 5. Opsional untuk pengetesan awal di tab "Test Events" Meta Events Manager (contoh: TEST48291)
# Kosongkan kembali setelah pengetesan berhasil agar masuk sebagai trafik produksi normal.
META_TEST_EVENT_CODE=
