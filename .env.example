# ============================================================================
# Konfigurasi Meta Pixel + Conversions API (CAPI) Khusus LP NanangDigital
# Isi variabel ini di menu Settings > Environment Variables pada dashboard Vercel
# ============================================================================

# 1. Dataset / Pixel ID 15-16 digit dari Meta Events Manager (dipakai Browser & Server)
VITE_META_PIXEL_ID=
META_PIXEL_ID=

# 2. Access Token Rahasia Conversions API dari Meta Events Manager > Settings
# PENTING: JANGAN beri awalan VITE_ agar token tetap rahasia hanya di server Vercel!
META_CAPI_ACCESS_TOKEN=

# 3. Opsional untuk pengetesan awal di tab "Test Events" Meta Events Manager (contoh: TEST48291)
# Kosongkan kembali setelah pengetesan berhasil agar masuk sebagai trafik produksi normal.
META_TEST_EVENT_CODE=

# 4. Opsional Google Analytics 4
VITE_GA_MEASUREMENT_ID=
