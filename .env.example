# ============================================================================
# Konfigurasi Alamat Website, Tracking, Google Search Console, & Meta CAPI NanangDigital
# Hosting utama Cloudflare Pages: isi di Settings > Variables and Secrets (klik Encrypt untuk token/API key)
# Alternatif Vercel: isi di Settings > Environment Variables
# Untuk pengetesan di komputer sendiri: salin file ini menjadi .env.local (tidak ikut Git)
# ============================================================================

# 0. Opsional: alamat utama website untuk canonical, hreflang, sitemap.xml, dan robots.txt.
# Kosongkan saja di Cloudflare Pages (otomatis mengikuti alamat <project>.pages.dev).
# Isi hanya kalau memakai domain sendiri, contoh: https://nanangdigital.com
SITE_URL=

# 1. Google Analytics 4 Measurement ID (sudah tertanam otomatis di kode: G-JY9N81NCQE)
VITE_GA_MEASUREMENT_ID=G-JY9N81NCQE

# 2. Google Search Console HTML Tag Verification (sudah tertanam otomatis di kode).
# Isi kode lain di sini hanya kalau Google memberi kode verifikasi baru; tag lama tetap dipertahankan.
VITE_GSC_VERIFICATION=cUtDIR_P8p7d7c7WhBW26zwoCDNGvTZuHAcGcS9X-B0

# 3. Dataset / Pixel ID Meta Ads (sudah tertanam otomatis di Browser & Server: 2971268586402489)
VITE_META_PIXEL_ID=2971268586402489
META_PIXEL_ID=2971268586402489

# 4. WAJIB DIISI DI HOSTING: Access Token Rahasia Conversions API (EAA...) dari Meta Events Manager > Settings
# PENTING: JANGAN beri awalan VITE_ agar token tetap aman hanya di server (Cloudflare Pages Functions / Vercel)!
META_CAPI_ACCESS_TOKEN=

# 5. Opsional untuk pengetesan awal di tab "Test Events" Meta Events Manager (contoh: TEST48291)
# Kosongkan kembali setelah pengetesan berhasil agar masuk sebagai trafik produksi normal.
META_TEST_EVENT_CODE=

# ============================================================================
# Live AI Chat (/api/ai-chat)
# Tanpa API key, chat tetap jalan memakai jawaban bawaan dari data website.
# ============================================================================

# 6. API key Google Gemini GRATIS dari https://aistudio.google.com/apikey
# PENTING: JANGAN beri awalan VITE_ agar API key tetap aman hanya di server (Cloudflare Pages Functions / Vercel)!
GEMINI_API_KEY=

# 7. Opsional: ganti model AI (bawaan: gemini-3.5-flash-lite, cadangan otomatis: gemini-flash-lite-latest & gemini-flash-latest)
AI_CHAT_MODEL=

# 8. Opsional: isi "true" HANYA setelah billing Google AI Studio aktif.
# Ketentuan Gemini: free tier tidak boleh melayani pengunjung dari Uni Eropa/EEA, Swiss, dan Inggris,
# jadi tanpa ini pengunjung dari negara tersebut otomatis dijawab basis pengetahuan bawaan.
GEMINI_PAID_TIER=

# 9. Opsional: provider lain yang OpenAI-compatible (contoh Groq/OpenRouter). Isi ketiganya sekaligus.
# AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
# AI_CHAT_API_KEY=
# AI_CHAT_MODEL=nama-model-dari-provider

# 10. Opsional: domain tambahan yang boleh memanggil /api/ai-chat (pisahkan dengan koma)
# AI_CHAT_ALLOWED_ORIGINS=www.domainanda.com
