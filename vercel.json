{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/meta-capi.js": {
      "maxDuration": 10
    },
    "api/ai-chat.js": {
      "maxDuration": 25
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "missing": [
        {
          "type": "host",
          "value": "nanangdigital.web.id"
        }
      ],
      "destination": "https://nanangdigital.web.id/:path*",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
